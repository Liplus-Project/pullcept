    "allow-kill-all-ptys",
    "allow-home-dir",
    "allow-load-config",
    "allow-save-config",
    "allow-account-env-text",
    "allow-seal-account-env",
    "allow-save-account-avatar",
    "allow-account-avatar",
    "allow-delete-account-avatar",
    "allow-save-sessions",
    "allow-load-sessions",
    "allow-room-port",
    "allow-room-participants",
