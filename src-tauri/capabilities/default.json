    "allow-preview-launch-args",
    "allow-start-session",
    "allow-mcp-servers",
    "allow-save-mcp-server",
    "allow-create-mcp-server",
    "allow-delete-mcp-server",
    "allow-restart-mcp-server",
    "allow-open-mcp-servers-file",
